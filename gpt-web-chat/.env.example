# Bot Configuration
BOT_USERNAME=gpt-web-chat

# AI Gateway (required for model replies)
# Local: set AI_GATEWAY_API_KEY. On Vercel, OIDC can replace this.
# AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4.1-mini

# Web
# The Web adapter delegates browser request authentication to the getUser config function.
# Constructor config: userName, getUser, protocol, persistMessageHistory, threadIdFor

# Memory
# No environment variables are required. State is kept in the current process.
